# PyroWatch backend configuration.
# Copy this file to `.env` (project root) and fill in the keys you have.
# Everything is optional — with no keys the app runs on clearly-flagged demo data.

# ---------------------------------------------------------------------------
# API keys (both free)
# FIRMS MAP_KEY:   https://firms.modaps.eosdis.nasa.gov/api/map_key/
# AirNow API key:  https://www.airnowapi.org/account/
# ---------------------------------------------------------------------------
FIRMS_MAP_KEY=
AIRNOW_API_KEY=

# auto = demo data when no FIRMS key; force = always demo; off = never demo
DEMO_MODE=auto
# Synthesize air-quality readings in demo mode too
DEMO_AQI=true

# ---------------------------------------------------------------------------
# FIRMS VIIRS NRT feeds and lookback window (1-5 days)
# ---------------------------------------------------------------------------
FIRMS_FEEDS=VIIRS_SNPP_NRT,VIIRS_NOAA20_NRT,VIIRS_NOAA21_NRT
FIRMS_DAY_RANGE=2

# ---------------------------------------------------------------------------
# Polling / storage / server
# ---------------------------------------------------------------------------
POLL_INTERVAL_MINUTES=10
DB_PATH=data/pyrowatch.db
PORT=8000
HOST=127.0.0.1

# ---------------------------------------------------------------------------
# Alert delivery (fired alerts are pushed out automatically)
#   webhook: POST JSON to any URL — set ALERT_WEBHOOK_URL, optional
#            ALERT_WEBHOOK_FORMAT=slack for Slack-style message blocks
#   email:   set SMTP_HOST + ALERT_EMAIL_TO (+ optionally SMTP settings below)
#   desktop: Windows toast on/off (defaults to true on Windows, false elsewhere)
# Alert rules themselves: ALERT_SCORE_DELTA / ALERT_SCORE_COOLDOWN_MIN
# ---------------------------------------------------------------------------
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=json
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASS=
# ALERT_DESKTOP=true
